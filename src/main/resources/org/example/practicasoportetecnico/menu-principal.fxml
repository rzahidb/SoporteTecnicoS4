<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.practicasoportetecnico.MenuPrincipalController"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="500.0"
      spacing="20.0">

    <padding>
        <Insets top="30.0"
                right="40.0"
                bottom="30.0"
                left="40.0"/>
    </padding>

    <Label text="Sistema de Soporte Técnico"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Menú Principal"
           style="-fx-font-size: 18px;"/>

    <Button text="Clientes"
            prefWidth="220.0"
            prefHeight="45.0"
            onAction="#abrirClientes"/>

    <Button text="Solicitud de Servicio"
            prefWidth="220.0"
            prefHeight="45.0"
            onAction="#abrirSolicitudServicio"/>

    <Button text="Salir"
            prefWidth="220.0"
            prefHeight="45.0"
            onAction="#salir"/>

</VBox>