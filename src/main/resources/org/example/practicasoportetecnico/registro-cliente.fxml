<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.practicasoportetecnico.RegistroClienteController"
      alignment="TOP_CENTER"
      prefHeight="580.0"
      prefWidth="700.0"
      spacing="20.0">

    <padding>
        <Insets top="25.0"
                right="35.0"
                bottom="25.0"
                left="35.0"/>
    </padding>

    <Label text="Registro de Clientes"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="15.0"
              vgap="18.0">

        <!-- Nombre -->
        <Label text="Nombre:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="txtNombre"
                   promptText="Ingrese el nombre"
                   prefWidth="350.0"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <!-- Correo -->
        <Label text="Correo:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="txtCorreo"
                   promptText="ejemplo@correo.com"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <!-- Teléfono -->
        <Label text="Teléfono:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="txtTelefono"
                   promptText="Ingrese 8 dígitos"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <!-- Tipo cliente -->
        <Label text="Tipo de cliente:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <ComboBox fx:id="cmbTipoCliente"
                  promptText="Seleccione el tipo de cliente"
                  prefWidth="350.0"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="3"/>

        <!-- Documento -->
        <Label text="Documento de identificación:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <HBox spacing="10.0"
              GridPane.columnIndex="1"
              GridPane.rowIndex="4">

            <TextField fx:id="txtDocumento"
                       editable="false"
                       promptText="Seleccione un archivo"
                       prefWidth="250.0"/>

            <Button text="Seleccionar"
                    onAction="#seleccionarDocumento"/>

        </HBox>

        <!-- Directorio -->
        <Label text="Directorio del cliente:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="5"/>

        <HBox spacing="10.0"
              GridPane.columnIndex="1"
              GridPane.rowIndex="5">

            <TextField fx:id="txtDirectorio"
                       editable="false"
                       promptText="Seleccione una carpeta"
                       prefWidth="250.0"/>

            <Button text="Seleccionar"
                    onAction="#seleccionarDirectorio"/>

        </HBox>

    </GridPane>

    <!-- Botones -->
    <HBox alignment="CENTER"
          spacing="15.0">

        <Button text="Guardar"
                prefWidth="110.0"
                onAction="#guardarCliente"/>

        <Button text="Crear Solicitud"
                prefWidth="130.0"
                onAction="#crearSolicitud"/>

        <Button text="Limpiar"
                prefWidth="110.0"
                onAction="#limpiarFormulario"/>

        <Button text="Cerrar"
                prefWidth="110.0"
                onAction="#cerrarVentana"/>

    </HBox>

</VBox>